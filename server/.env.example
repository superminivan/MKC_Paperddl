## Server runtime
# PORT=5000

## Auth (required)
# Generate a long random string for production
JWT_SECRET=change-me
# JWT_EXPIRES_IN=7d

## MySQL (when not using docker-compose overrides)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DATABASE=paperddl
# MYSQL_USER=root
# MYSQL_PASSWORD=

## Cookies / CORS
# COOKIE_NAME=paperddl_token
# COOKIE_SECURE=false
# CORS_ORIGIN=http://localhost

## Data root (optional)
# DATA_ROOT=../conference

